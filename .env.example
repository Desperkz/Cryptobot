# Never commit real secrets. Copy to .env and fill only the keys you need.

# Binance USD-M Futures testnet/demo keys
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Binance mainnet keys. MAINNET_LIVE remains blocked unless config.yaml confirms it.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional market-cap source key. Public CoinGecko can work with lower limits.
COINGECKO_API_KEY=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Deposit conversion:
# Do not let the bot guess KZT/USDT. Provide either STARTING_DEPOSIT_USDT
# or MANUAL_TENGE_USDT_RATE. Example: 100000 KZT / 500 KZT per USDT = 200 USDT.
STARTING_DEPOSIT_USDT=
MANUAL_TENGE_USDT_RATE=

