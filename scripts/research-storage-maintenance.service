[Unit]
Description=Lossless cold storage of consumed research snapshots

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/bot_research_storage/code
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=research-storage-maintenance
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/flock -n /run/research-storage-maintenance/lock /usr/bin/python3 /root/bot_research_storage/code/research_storage_maintenance.py
ExecStopPost=/usr/bin/python3 /root/bot_research_storage/code/research_storage_maintenance.py --recover-timers
Nice=19
CPUQuota=10%
MemoryHigh=96M
MemoryMax=160M
MemorySwapMax=64M
TasksMax=16
TimeoutStartSec=900
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/root/bot_research_storage/code /root/bot_diversified_shadow/code /root/bot_diversified_v3/code
ReadWritePaths=/root/bot_research_storage/data /root/bot_research_storage/archives /root/bot_research_storage/backups /root/bot_research_storage/temporary /root/bot_research_storage/reports
ReadWritePaths=/root/bot_diversified_shadow /root/bot_diversified_v3

[Install]
WantedBy=multi-user.target
